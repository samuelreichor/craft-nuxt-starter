{
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": "^8.4",
    "craftcms/ckeditor": "^5.9.0",
    "craftcms/cms": "^5.12.2",
    "nystudio107/craft-seomatic": "^5.1.24",
    "samuelreichor/craft-query-api": "^3.8.0",
    "samuelreichor/craft-quick-edit": "^5.3.1",
    "spacecatninja/imager-x": "^6.3.0",
    "verbb/navigation": "^4.1.0",
    "vlucas/phpdotenv": "^5.8.1"
  },
  "require-dev": {
    "craftcms/generator": "^2.2.0",
    "yiisoft/yii2-shell": "^2.0.6"
  },
  "config": {
    "allow-plugins": {
      "craftcms/plugin-installer": true,
      "yiisoft/yii2-composer": true
    },
    "sort-packages": true,
    "optimize-autoloader": true
  },
  "scripts": {
    "generate-types": "php craft query-api/typescript/generate-types --output=@root/frontend/types/base.ts",
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example.dev', '.env');\""
    ]
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://composer.craftcms.com",
      "canonical": false
    }
  ],
  "autoload": {
    "psr-4": {
      "modules\\queryapiextensions\\": "modules/query-api-extensions/",
      "modules\\hrpreview\\": "modules/hr-preview/"
    }
  }
}
